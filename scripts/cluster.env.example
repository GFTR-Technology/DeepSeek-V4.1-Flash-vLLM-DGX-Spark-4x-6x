# Copy to cluster.env next to this file and edit.
#   cp scripts/cluster.env.example scripts/cluster.env
# cluster.env is gitignored. Do not commit your IPs.

SSH_USER=nvidia

# Fabric IPs used for NCCL + SSH between Sparks (not the management NIC).
# TP is the node count: HEAD_IP plus WORKER_IPS. Four nodes means TP=4, which is
# the published recipe. Six means TP=6, which divides none of this model's head
# counts — the launcher wires in patch/dsv41_tp_pad automatically.
HEAD_IP=192.168.192.2
WORKER_IPS="192.168.192.4 192.168.192.3 192.168.192.1"
# six-node: WORKER_IPS="192.168.192.4 ... .3 ... .1 ... .5 ... .6"

# Dual-rail RoCE on DGX Spark. Single-rail: set both to one device.
# The container entrypoint picks the RoCEv2 IPv4 GID index itself.
NCCL_IB_HCA=rocep1s0f0,roceP2p1s0f0
NCCL_SOCKET_IFNAME=enp1s0f0np0,enP2p1s0f0np0
GLOO_SOCKET_IFNAME=enp1s0f0np0

# The head holds the 510 GB checkpoint on local NVMe and exports it over NFS.
# Keep it somewhere world-traversable: with NFS root_squash the container reads
# as nobody, so a path under /root (mode 0700) mounts fine and then fails every
# read. /var/tmp/models is what the recipe uses.
# fetch-weights.sh builds the export ACL from the address each worker actually
# reaches the head from; NFS_EXPORT_CLIENTS="10.10.0.0/16" overrides it.
# WORKER_WEIGHTS is where the workers see that export. Same path everywhere
# (rsync instead of NFS)? Drop WORKER_WEIGHTS and only set WEIGHTS.
WEIGHTS=/var/tmp/models/DeepSeek-V4.1-Flash
WORKER_WEIGHTS=/mnt/reddie-models/DeepSeek-V4.1-Flash
CACHE=/var/tmp/dsv41-vllm-cache

# The engine image, node-local on every box (scripts/copy-image.sh distributes it).
#
# vllm-dsv41:overlay5 is what this repo builds and what every measured number came
# from: the day-0 dsv41-feat tree, _C_stable_libtorch rebuilt for sm_121a, and
# FlashInfer 0.7.0rc1 with the SM120 kernels prebuilt. ./scripts/build-image.sh
# --check tells you what that build still needs.
#
# There are also published day-0 images. The tags are dated, not a bare
# "deepseekv41-flash" — on Docker Hub they look like deepseekv41-flash-0909 and
# deepseekv41-flash-0909-cu129, each with -amd64 / -arm64 variants. DGX Spark is
# ARM64, so trying this costs one pull:
#   IMAGE=vllm/vllm-openai:deepseekv41-flash-0909-arm64
# List what actually exists before pulling:
#   curl -s 'https://hub.docker.com/v2/repositories/vllm/vllm-openai/tags?page_size=100&name=deepseekv41' \
#     | python3 -c "import json,sys;[print(t['name']) for t in json.load(sys.stdin)['results']]"
# dsv41-node-launch.sh adds --tokenizer-mode deepseek_v41 by itself for any
# *deepseekv41-flash-0909* image (the overlay images reject that flag).
# Caveat: this repo exists because the stock ARM64 wheels carried no sm_121a
# kernels for GB10 — whether a published image covers SM 12.1 is untested here.
# If the engine dies in a kernel at load, build overlay5.
IMAGE=vllm-dsv41:overlay5
NAME=vllm_dsv41
PORT=8000
MASTER_PORT=29541

# --gpu-memory-utilization. THE knob when a boot dies for space.
# On GB10 the "GPU pool" is the same 128 GB of unified memory the OS uses, so
# this fraction is competing with the page cache and everything else on the box.
# Measured at TP=4, gmu 0.80: 81.58 GiB of weights per rank (with the DSpark
# draft layers and the vision encoder), 1.99 + 0.55 GiB of CUDA graphs, and a
# 5.15 GiB KV pool = 1,070,168 tokens at 300K context.
#   dies while LOADING WEIGHTS      -> lower it (0.78, 0.75, ...). Fewer nodes
#                                      means more weight per rank, so TP=4 needs
#                                      more headroom than TP=6.
#   loads, then dies at KV init     -> lower it too; the KV pool is what is left
#                                      over after weights and graphs.
#   loads fine and you want more KV -> raise it (0.85 only on a stripped OS).
# Other things that buy room, in order of what they cost you:
#   DSV41_TEXT_ONLY=1   drops the vision encoder, ~0.22 GiB per rank
#   DSV41_LANE=128k     shorter context, smaller indexer prefill buffer
#   DSV41_SPEC=none     drops the DSpark draft layers entirely
GMU=0.80

# Refuse to start a node with less than this much MemAvailable (GiB). The load
# needs ~100 of the 121.7 GiB the OS can see; a leftover page cache is what
# turns that into an OOM kill ten minutes in. Every boot drops caches first.
MIN_AVAIL_GB=100

# Engram n-gram tables (203 GB) stay on disk — without this the model does not
# fit. ENGRAM_LOCAL mounts each worker's node-local copy of its own rows and is
# ON by default: over NFS those reads cost 5.9-7.8 ms per step against 2.8 ms
# locally, and every step waits for the slowest rank (boot 10: 60.8 -> 84.9 tok/s).
# dsv41-serve.sh builds the copies itself when they are missing or stale (~48 GB
# per worker at TP=4, a few minutes, once) — set DSV41_ENGRAM_AUTOBUILD=0 to skip
# that and run scripts/engram-local.sh by hand instead.
# A node without a copy is not an error: the container entrypoint drops the mount
# and that rank reads the model dir as before.
ENGRAM_DISK=1
ENGRAM_LOCAL=1
ENGRAM_LOCAL_DIR=/var/tmp/engram-local/DeepSeek-V4.1-Flash

# Hugging Face card. Weights are not in this repo.
HF_REPO=deepseek-ai/DeepSeek-V4.1-Flash
# Base for the overlay chain: the exact merge-base of the (now deleted) dsv41-feat
# branch. Only needed by scripts/build-image.sh, not to serve.
HF_BASE_IMAGE=vllm/vllm-openai:nightly-8a728663c1c3eeace834a95f5654fa653cc1998c
