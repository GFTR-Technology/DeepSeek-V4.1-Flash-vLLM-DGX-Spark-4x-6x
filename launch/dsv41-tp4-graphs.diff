-    $TEXT_ARGS $PARSER_ARGS $SPEC_ARGS $GRAPH_ARGS \
+    $TEXT_ARGS $PARSER_ARGS $SPEC_ARGS "${GRAPH_ARGS[@]}" \
     --distributed-executor-backend mp --nnodes 4 --node-rank "$NODE_RANK" \
